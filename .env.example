# Flask secret key used to sign the session cookie (required).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-string

# Set to "false" in production
FLASK_DEBUG=true

# Port the Flask dev server runs on
PORT=5000

# --- Optional AI enhancement ---
# Leave OPENAI_API_KEY blank to use the built-in rule-based conversational
# engine (no external calls, fully offline, safe for local demos).
# If you provide a key, MindCare AI will use OpenAI for richer responses,
# while the safety/crisis-detection layer still always runs locally first
# and is never bypassed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
